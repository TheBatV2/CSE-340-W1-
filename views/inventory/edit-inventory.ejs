<div class="form-container">
  <h1>Edit Inventory Item</h1>
  <% if (messages && messages.length > 0) { %>
      <ul class="notice">
          <% messages.forEach(function(msg) { %>
              <li><%= msg %></li>
          <% }) %>
      </ul>
  <% } %>
  <form id="updateForm"  class="add-inventory-form" action="/inv/update" method="post">
    <label for="classificationList">Classification:</label>
    <%- classificationSelect %>

    <label for="inv_make">Make:</label>
    <input type="text" id="inv_make" name="inv_make" required pattern="^[A-Za-z0-9 ]+$"
      value="<%= typeof inv_make !== 'undefined' ? inv_make : '' %>">

    <label for="inv_model">Model:</label>
    <input type="text" id="inv_model" name="inv_model" required pattern="^[A-Za-z0-9 ]+$"
      value="<%= typeof inv_model !== 'undefined' ? inv_model : '' %>">

    <label for="inv_year">Year:</label>
    <input type="number" id="inv_year" name="inv_year" min="1900" max="2099" required
      value="<%= typeof inv_year !== 'undefined' ? inv_year : '' %>">

    <label for="inv_description">Description:</label>
    <textarea id="inv_description" name="inv_description" required><%= typeof inv_description !== 'undefined' ? inv_description : '' %></textarea>

    <label for="inv_image">Image Path:</label>
    <input type="text" id="inv_image" name="inv_image" required
      value="<%= typeof inv_image !== 'undefined' ? inv_image : '/images/vehicles/no-image.png' %>">

    <label for="inv_thumbnail">Thumbnail Path:</label>
    <input type="text" id="inv_thumbnail" name="inv_thumbnail" required
      value="<%= typeof inv_thumbnail !== 'undefined' ? inv_thumbnail : '/images/vehicles/no-image-tn.png' %>">

    <label for="inv_price">Price:</label>
    <input type="number" id="inv_price" name="inv_price" min="0" step="0.01" required
      value="<%= typeof inv_price !== 'undefined' ? inv_price : '' %>">

    <label for="inv_miles">Miles:</label>
    <input type="number" id="inv_miles" name="inv_miles" min="0" required
      value="<%= typeof inv_miles !== 'undefined' ? inv_miles : '' %>">

    <label for="inv_color">Color:</label>
    <input type="text" id="inv_color" name="inv_color" required pattern="^[A-Za-z0-9 ]+$"
      value="<%= typeof inv_color !== 'undefined' ? inv_color : '' %>">

    <button type="submit" disabled>Update Vehicle</button>

    <input type="hidden" name="inv_id"
      <% if(locals.inv_id) { %> value="<%= locals.inv_id %>" <% } %>>
  </form>
  <div class="management-link">
    <a href="/inv/">Back to Management</a>
  </div>
</div>
<script src="/js/inv-update.js"></script>

