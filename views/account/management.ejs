<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Account Management</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main>
 
    <% if (accountFirstName && accountType) { %>
      <div class="add-inventory-form">
      <h2 class="center-text">Welcome <%= accountFirstName %></h2>
      <!-- Update Account Information link (always visible) -->
      <p class="center-text">
        <a href="/account/update/<%= accountId %>">Update Account Information</a>
      </p>
      <% if (accountType === "Employee" || accountType === "Admin") { %>
        <h3 class="center-text">Inventory Management</h3>
        <p class="center-text">
          <a href="/inv/">Go to Inventory Management</a>
        </p>
      <% } %>
    <% } %>
    <p class="center-text">You're logged in.</p>
      </div>
    <!-- Add this after your existing welcome section -->
    <% if (userReviews && userReviews.length > 0) { %>
      <div class="user-reviews-section">
        <h3>Your Reviews</h3>
        <% userReviews.forEach(review => { %>
          <div class="user-review-item">
            <p><strong>Vehicle:</strong> <%= review.inv_year %> <%= review.inv_make %> <%= review.inv_model %></p>
            <p class="review-text"><%= review.review_text %></p>
            <p class="review-date">Posted: <%= new Date(review.review_date).toLocaleDateString() %></p>
            <div class="review-actions">
              <a href="/review/edit/<%= review.review_id %>" class="edit-link">Edit</a>
              <a href="/review/delete/<%= review.review_id %>" class="delete-link" onclick="return confirm('Are you sure you want to delete this review?')">Delete</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>