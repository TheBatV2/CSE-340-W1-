<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <main>
    <h1><%= title %></h1>

    <% if (messages && messages.length > 0) { %>
      <ul class="notice">
        <% messages.forEach(function(msg) { %>
          <li><%= msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <% if (errors && errors.length > 0) { %>
      <ul class="notice">
        <% errors.forEach(function(error) { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>

    <div class="add-inventory-form">
      <form class="account-update-form" action="/account/update" method="post" novalidate>
        <h2>Account Update</h2>
        <label for="account_firstname">First Name:</label>
        <input
          type="text"
          id="account_firstname"
          name="account_firstname"
          required
          pattern="^[A-Za-z'-]{2,}$"
          value="<%= typeof account_firstname !== 'undefined' ? account_firstname : '' %>"
        >

        <label for="account_lastname">Last Name:</label>
        <input
          type="text"
          id="account_lastname"
          name="account_lastname"
          required
          pattern="^[A-Za-z'-]{2,}$"
          value="<%= typeof account_lastname !== 'undefined' ? account_lastname : '' %>"
        >

        <label for="account_email">Email:</label>
        <input
          type="email"
          id="account_email"
          name="account_email"
          required
          value="<%= typeof account_email !== 'undefined' ? account_email : '' %>"
        >

        <input type="hidden" name="account_id" value="<%= typeof account_id !== 'undefined' ? account_id : '' %>">

        <button type="submit">Update Account</button>
      </form>
    </div>

    <div class="form-container">
      <form class="add-inventory-form" action="/account/update-password" method="post" novalidate>
        <h2>Change Password</h2>
        <p>
          Enter a new password to change your current password.<br>
          <strong>Password requirements:</strong> At least 12 characters, including uppercase, lowercase, number, and special character.
        </p>
        <label for="account_password">New Password:</label>
        <input
          type="password"
          id="account_password"
          name="account_password"
          required
          pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[\\W_]).{12,}$"
          title="Password must be at least 12 characters and include uppercase, lowercase, number, and special character."
        >

        <input type="hidden" name="account_id" value="<%= typeof account_id !== 'undefined' ? account_id : '' %>">

        <button type="submit">Change Password</button>
      </form>
    </div>
  </main>
</body>
</html>