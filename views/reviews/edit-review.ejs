<%- include('../partials/head') %>
<%- include('../partials/header') %>
<%- include('../partials/nav') %>

<main>
  <div class="add-inventory-form">
    <h1>Edit Review</h1>
    <%- messages() %>
    <% if (errors) { %>
      <ul class="notice">
        <% errors.forEach(function(error) { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>
    
    <form action="/review/edit" method="post">
      <p><strong>Vehicle:</strong> <%= inv_year %> <%= inv_make %> <%= inv_model %></p>
      
      <label for="review_text">Review:</label>
      <textarea id="review_text" name="review_text" rows="6" required><%= review_text %></textarea>
      
      <input type="hidden" name="review_id" value="<%= review_id %>">
      
      <button type="submit">Update Review</button>
    </form>
    
    <div class="management-link">
      <a href="/account/">Back to Account Management</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>