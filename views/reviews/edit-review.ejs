
  <div class="edit-review-container">
    <h1>Edit Review</h1>
    <%- messages %>
    
    <% if (errors) { %>
      <ul class="notice">
        <% errors.forEach(function(error) { %>
          <li><%= error.msg %></li>
        <% }) %>
      </ul>
    <% } %>
    
    <div class="vehicle-info-box">
      <h3>Vehicle Details</h3>
      <p><strong><%= inv_year %> <%= inv_make %> <%= inv_model %></strong></p>
    </div>
    
    <form class="edit-review-form" action="/review/edit" method="post">
      <div class="form-group">
        <label for="review_text">Your Review:</label>
        <textarea id="review_text" name="review_text" rows="8" required><%= review_text %></textarea>
        <small class="form-help">Share your experience with this vehicle</small>
      </div>
      
      <input type="hidden" name="review_id" value="<%= review_id %>">
      
      <div class="form-actions">
        <button type="submit" class="btn-primary">Update Review</button>
        <a href="/account/" class="btn-secondary">Cancel</a>
      </div>
    </form>
  </div>



